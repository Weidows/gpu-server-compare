{
  "openapi": "3.1.0",
  "info": {
    "title": "GPU & Server Compare API",
    "version": "1.0.0",
    "description": "Static JSON API for GPU/server comparison. All files are static, CORS *, no auth. Base: https://server-mark.weidows.tech"
  },
  "servers": [
    {
      "url": "https://server-mark.weidows.tech"
    }
  ],
  "paths": {
